# Admin Configuration
ADMIN_EMAIL=

# Neon Serverless Postgres Connection String
# Get your connection string from Neon Console: https://console.neon.tech
# Leave empty for single-process local development. Set a real PostgreSQL URL for production.
DATABASE_URL=

# Resend API Key for Email Verification
RESEND_API_KEY=

# App Environment
NEXT_PUBLIC_APP_ENV=development

# Application origin and authentication (use a long random secret)
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# AI model used by live channels and website widget
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Instagram: not connected until credentials, permissions and subscription succeed
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=

# Protected channel recovery endpoint, called by a scheduler every minute
CRON_SECRET=

# Google Calendar API (OAuth 2.0 Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback
